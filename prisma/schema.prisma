generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"] // Required for Cloudflare D1 adapter
  engineType      = "library"          // Required for Cloudflare D1
  binaryTargets   = ["native"]
}

datasource db {
  provider = "sqlite"  // Cloudflare D1 uses SQLite
  url      = env("DATABASE_URL") // Placeholder only - D1 doesn't use URLs, adapter handles connection via API
}
// NOTE: Cloudflare D1 (SQLite) does not support native enums or Json columns in Prisma.
// To keep compatibility with D1, enum-like fields are modelled as String and
// Json fields are stored as text (String). Enforce allowed values in application code.

// Core user and org models
model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  password              String
  isActive              Int         @default(1) // Boolean as Int (1=true, 0=false)
  emailVerified         Int         @default(0) // Boolean as Int (1=true, 0=false)
  createdAt             Int         // Unix timestamp
  updatedAt             Int         // Unix timestamp
  lastLoginAt           Int?        // Unix timestamp 
  defaultOrganizationId String?
  defaultOrganization   Organization? @relation("UserDefaultOrganization", fields: [defaultOrganizationId], references: [id], onDelete: SetNull)
  ownedOrganizations    Organization[] @relation("OrganizationOwner")
  memberships           OrganizationMembership[]
  profile               UserProfile?
  roles                 UserRole[]
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId             String?
  manager               User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports               User[]      @relation("UserManager")
  activities            Activity[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  qualityTests          QualityTest[]
  ticketComments        TicketComment[]
  documentsUploaded     Document[]
  salesTargets          SalesTarget[]
  commissions           Commission[]
  verificationTokens    VerificationToken[]
  magicLinkTokens       MagicLinkToken[] @relation("MagicLinkTokens")
  invitationsSent       OrganizationInvite[] @relation("InvitedBy")
  productionStageLogs   ProductionStageLog[]
  packagingRuns         PackagingRun[]
}

model Organization {
  id        String                   @id @default(uuid())
  name      String
  slug      String                   @unique
  code      String                   @unique // 6-8 character alphanumeric code for joining
  ownerId   String
  createdAt Int
  updatedAt Int

  owner     User                     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships OrganizationMembership[]
  defaultUsers User[] @relation("UserDefaultOrganization")

  connections        Connection[]
  products           Product[]
  milkCollectionCenters MilkCollectionCenter[]
  milkProcurements   MilkProcurementEntry[]
  milkRateCharts     MilkRateChart[]
  productionBatches  ProductionBatch[]
  qualityTests       QualityTest[]
  salesInquiries     SalesInquiry[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  orderItems         OrderItem[]
  invoices           Invoice[]
  payments           Payment[]
  deliveryChallans   DeliveryChallan[]
  storageLocations   StorageLocation[]
  inventoryStocks    InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders     PurchaseOrder[]
  bills              Bill[]
  supportTickets     SupportTicket[]
  supplierFeedbacks  SupplierFeedback[]
  activities         Activity[]
  documents          Document[]
  notifications      Notification[]
  salesTargets       SalesTarget[]
  commissions        Commission[]
  commissionRules    CommissionRule[]
  auditLogs          AuditLog[]
  invites            OrganizationInvite[]
  productionStageLogs ProductionStageLog[]
  packagingLines     PackagingLine[]
  packagingRuns      PackagingRun[]
  packagingOutputs   PackagingOutput[]
  processAlerts      ProcessAlert[]
  machineTelemetries MachineTelemetry[]
}

model OrganizationMembership {
  id             String        @id @default(uuid())
  userId         String
  organizationId String
  role           String

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model UserProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String?
  phone      String?
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  roleTitle  String?
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  desc  String?
  users UserRole[]
}

model UserRole {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@unique([userId, roleId])
}

model Department {
  id    String @id @default(uuid())
  name  String @unique
  desc  String?
  users User[]
}

// Connections and contacts
model Connection {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  type               String           // e.g., "SUPPLIER", "CUSTOMER", "BOTH"
  businessCategory   String           // e.g., "DAIRY_FARM", "DISTRIBUTOR"
  primaryContactId   String?
  contacts           ContactPerson[]
  fssaiLicenses      FSSAILicense[]
  gstNumber          String?
  creditLimit        Float?           @default(0)
  paymentTermsDays   Int?             @default(0)
  hasColdStorage     Int?             @default(0) // Boolean as Int
  deliveryPreferences String?
  procurements       MilkProcurementEntry[]
  salesInquiries     SalesInquiry[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  purchaseOrders     PurchaseOrder[]
  bills              Bill[]
  supportTickets     SupportTicket[]
  supplierFeedbacks  SupplierFeedback[]
  createdAt          Int              // Unix timestamp
  updatedAt          Int              // Unix timestamp
}

model ContactPerson {
  id            String     @id @default(uuid())
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId  String
  fullName      String
  email         String?
  phone         String?
  isPrimary     Int        @default(0) // Boolean as Int
}

model FSSAILicense {
  id            String     @id @default(uuid())
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId  String
  licenseNumber String
  issueDate     Int?       // Unix timestamp
  expiryDate    Int?       // Unix timestamp
}

// Products & catalog
model Product {
  id                 String               @id @default(uuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                String?              @unique
  name               String
  category           String               // e.g., "MILK", "CURD", "BUTTER"
  subCategory        String?
  description        String?
  unit               String               // e.g., "LITRE", "KG", "PIECE"
  packSize           String?              // human readable: "200 ml", "1 L"
  minFatPercent      Float?                // Float for Float
  minSnfPercent      Float?                // Float for Float
  shelfLifeDays      Int?
  storageTempMin     Float?                // Float for Float
  storageTempMax     Float?                // Float for Float
  requiresColdChain  Int                  @default(0) // Boolean as Int
  unitPrice          Float?                // Float for Float
  costPrice          Float?                // Float for Float
  currentStock       Float?                @default(0) // Float for Float
  reorderLevel       Float?                @default(0) // Float for Float
  minOrderQuantity   Float?                @default(0) // Float for Float
  priceHistory       ProductPriceHistory[]
  inventoryStocks    InventoryStock[]
  orderItems         OrderItem[]
  productionBatches  ProductionBatchItem[]
  productionBatchesByProduct ProductionBatch[]
  quoteLineItems     QuoteLineItem[]
  salesInquiries     SalesInquiry[]
  packagingOutputs   PackagingOutput[]
}

model ProductPriceHistory {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  unitPrice  Float     // Float for Float
  costPrice  Float?    // Float for Float
  startDate  Int      // Unix timestamp
  endDate    Int?     // Unix timestamp
}

// Milk procurement
model MilkCollectionCenter {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  latitude           Float?    // Float for Float
  longitude          Float?    // Float for Float
  dailyCapacityL     Float?    @default(0) // Float for Float
  bmrAvailable       Int?     @default(0) // Boolean as Int
  hasTestingEquip    Int?     @default(0) // Boolean as Int
  procurements       MilkProcurementEntry[]
}

model MilkProcurementEntry {
  id                String                     @id @default(uuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Connection                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  collectionCenterId String?
  collectionCenter  MilkCollectionCenter?      @relation(fields: [collectionCenterId], references: [id], onDelete: SetNull)
  datetime          Int                        // Unix timestamp
  quantityL         Float                       // Float for Float
  fatPercent        Float?                      // Float for Float
  snfPercent        Float?                      // Float for Float
  clrReading        Float?                      // Float for Float
  temperatureC      Float?                      // Float for Float
  qualityGrade      String                     // e.g., "A", "B", "C"
  ratePerLitre      Float                       // Float for Float
  totalAmount       Float                       // Float for Float
  paymentStatus     String   @default("PENDING") // e.g., "PENDING", "PAID"
  milkType          String?
  createdAt         Int                        // Unix timestamp
}

model MilkRateChart {
  id           String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fatPercentMin Float     // Float for Float
  fatPercentMax Float     // Float for Float
  snfPercentMin Float     // Float for Float
  snfPercentMax Float     // Float for Float
  milkType     String
  qualityGrade String
  ratePerLitre Float      // Float for Float
  effectiveFrom Int      // Unix timestamp
  effectiveTo   Int?     // Unix timestamp
}

// Production
model ProductionBatch {
  id               String                 @id @default(uuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchNumber      String                 @unique
  productId        String
  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  producedQty      Float                   // Float for Float
  productionDate   Int                    // Unix timestamp
  manufacturingDate Int?                  // Unix timestamp
  expiryDate       Int?                   // Unix timestamp
  status           String   @default("IN_PRODUCTION") // e.g., "IN_PRODUCTION", "COMPLETED"
  fatBefore        Float?                  // Float for Float
  fatAfter         Float?                  // Float for Float
  snfBefore        Float?                  // Float for Float
  snfAfter         Float?                  // Float for Float
  agitationRunning Int?    @default(0)     // Boolean as Int
  machineRuntimeMinutes Int?
  standardizationFormula String?
  lossPercent      Float?                  // Float for Float
  temperatureProfile String?              // JSON string for chart data
  holdingTimeSec   Int?
  homogenizationPressure Float?           // Float for Float
  qualityStatus    String?  @default("PENDING")
  siloId           String?
  creamSeparatorId String?
  pasteurizerId    String?
  homogenizerId    String?
  items            ProductionBatchItem[]
  orderItems       OrderItem[]
  inventoryStocks  InventoryStock[]
  stageLogs        ProductionStageLog[]
  packagingRuns    PackagingRun[]
  alerts           ProcessAlert[]
  telemetry        MachineTelemetry[]
}

model ProductionBatchItem {
  id             String @id @default(uuid())
  batchId        String
  batch          ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMilkUsedL   Float?  // Float for Float
  quantity       Float   // Float for Float
}

// Quality control
model QualityTest {
  id             String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testDate       Int        // Unix timestamp
  testedById     String?
  testedBy       User?      @relation(fields: [testedById], references: [id], onDelete: SetNull)
  targetType     String     // e.g., "RawMilk", "Batch", "InProcess"
  targetId       String?    // reference id
  parameters     String?    // JSON as String (serialize/deserialize in app)
  outcome        String     // e.g., "PASS", "FAIL", "CONDITIONAL"
  remarks        String?
}

model ProductionStageLog {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId        String
  batch          ProductionBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stageName      String
  status         String            @default("PENDING") // e.g., PENDING, PASS, FAIL
  parameters     String?           // JSON payload for FAT/SNF, temp, etc.
  startedAt      Int?
  completedAt    Int?
  recordedById   String?
  recordedBy     User?             @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  remarks        String?
  alerts         ProcessAlert[]
}

model PackagingLine {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  lineType           String            // e.g., POUCH, CUP, BOTTLE
  speedUnitsPerHour  Float?            // Float for Float
  isActive           Int               @default(1) // Boolean as Int
  isUnderMaintenance Int               @default(0) // Boolean as Int
  maintenanceNotes   String?
  lastMaintenanceAt  Int?
  nextMaintenanceDue Int?
  packagingRuns      PackagingRun[]
  telemetry          MachineTelemetry[]
}

model PackagingRun {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId          String
  batch            ProductionBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  packagingLineId  String
  packagingLine    PackagingLine     @relation(fields: [packagingLineId], references: [id], onDelete: Cascade)
  operatorId       String?
  operator         User?             @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  status           String            @default("PLANNED") // PLANNED, RUNNING, COMPLETED, STOPPED
  startedAt        Int?
  completedAt      Int?
  plannedOutput    Float?            // Float for Float
  actualOutput     Float?            // Float for Float
  rejectsCount     Float?            // Float for Float
  materialUsedKg   Float?            // Float for Float
  outputs          PackagingOutput[]
  alerts           ProcessAlert[]
  inventoryTransactions InventoryTransaction[]
}

model PackagingOutput {
  id              String          @id @default(uuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packagingRunId  String
  packagingRun    PackagingRun    @relation(fields: [packagingRunId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  packType        String?
  filledUnits     Float?          // Float for Float
  rejectedUnits   Float?          // Float for Float
  materialUsedKg  Float?          // Float for Float
  materialBatch   String?
  recordedAt      Int?            // Unix timestamp
}

model ProcessAlert {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertType        String
  severity         String             // INFO, WARNING, CRITICAL
  message          String
  createdAt        Int                // Unix timestamp
  acknowledged     Int                @default(0) // Boolean as Int
  acknowledgedAt   Int?
  batchId          String?
  batch            ProductionBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  stageLogId       String?
  stageLog         ProductionStageLog? @relation(fields: [stageLogId], references: [id], onDelete: SetNull)
  packagingRunId   String?
  packagingRun     PackagingRun?      @relation(fields: [packagingRunId], references: [id], onDelete: SetNull)
}

model MachineTelemetry {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            ProductionBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  packagingLineId  String?
  packagingLine    PackagingLine?    @relation(fields: [packagingLineId], references: [id], onDelete: SetNull)
  machineType      String            // e.g., SILO, CHILLER, SEPARATOR
  machineId        String?
  parameter        String            // e.g., TEMPERATURE, RUNTIME
  value            Float?            // Float for Float
  unit             String?
  recordedAt       Int               // Unix timestamp
  notes            String?
}

// Sales pipeline
model SalesInquiry {
  id            String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiryNumber String    @unique
  connectionId  String
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity      Float?     // Float for Float
  quotedPrice   Float?     // Float for Float
  status        String?
  source        String?
  createdAt     Int       // Unix timestamp
}

model Quotation {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteRef       String         @unique
  connectionId   String
  connection     Connection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  subtotal       Float           // Float for Float
  gstCGST        Float?          // Float for Float
  gstSGST        Float?          // Float for Float
  gstIGST        Float?          // Float for Float
  discount       Float?          // Float for Float
  transportCharges Float?        // Float for Float
  coldChainCharges Float?        // Float for Float
  deliveryTerms  String?
  paymentTerms   String?
  status         String?
  createdAt      Int            // Unix timestamp
  lineItems      QuoteLineItem[]
}

model QuoteLineItem {
  id          String    @id @default(uuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty         Float      // Float for Float
  unitPrice   Float      // Float for Float
  totalPrice  Float      // Float for Float
}

model SalesOrder {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderRef       String    @unique
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  stage          String?
  deliveryAddress String?
  distanceKm     Float?     // Float for Float
  vehicleReq     String?
  createdAt      Int       // Unix timestamp
  items          OrderItem[]
  invoices       Invoice[]
}

model OrderItem {
  id            String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId  String
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty           Float       // Float for Float
  price         Float       // Float for Float
  batchId       String?
  batch         ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  mfgDate       Int?       // Unix timestamp
  expiryDate    Int?       // Unix timestamp
}

model Invoice {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String    @unique
  salesOrderId   String?
  salesOrder     SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  dueDate        Int?      // Unix timestamp
  totalAmount    Float      // Float for Float
  paidAmount     Float      @default(0) // Float for Float
  status         String?
  createdAt      Int       // Unix timestamp
  payments       Payment[]
}

model Payment {
  id            String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Float     // Float for Float
  method        String
  referenceNo   String?
  bankName      String?
  paidAt        Int      // Unix timestamp
  status        String?
}

model DeliveryChallan {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challanNumber   String   @unique
  salesOrderId    String?
  vehicleNumber   String?
  driverName      String?
  driverPhone     String?
  tempInitialC    Float?    // Float for Float
  tempFinalC      Float?    // Float for Float
  signedBy        String?
  deliveredAt     Int?     // Unix timestamp
}

// Inventory
model StorageLocation {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           String   // Cold Room / Freezer / Refrigerated Warehouse
  capacity       Float?    // Float for Float
  currentLoad    Float?    @default(0) // Float for Float
  tempMin        Float?    // Float for Float
  tempMax        Float?    // Float for Float
  currentTemp    Float?    // Float for Float
  operational    Int?     @default(1) // Boolean as Int
  maintenanceLog String?  // JSON as String
  stocks         InventoryStock[]
}

model InventoryStock {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  storageLocationId String
  storageLocation  StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  quantity         Float            // Float for Float
  mfgDate          Int?            // Unix timestamp
  expiryDate       Int?            // Unix timestamp
  createdAt        Int             // Unix timestamp
  txns             InventoryTransaction[]
}

model InventoryTransaction {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockId          String
  stock            InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type             String   // e.g., "IN", "OUT", "ADJUSTMENT"
  qty              Float     // Float for Float
  referenceType    String?   // e.g., "SalesOrder", "ProductionBatch"
  referenceId      String?
  packagingRunId   String?
  packagingRun     PackagingRun? @relation(fields: [packagingRunId], references: [id], onDelete: SetNull)
  createdAt        Int      // Unix timestamp
}

model PurchaseOrder {
  id             String    @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poRef          String    @unique
  type           String
  supplierId     String
  supplier       Connection @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  expectedDate   Int?      // Unix timestamp
  actualDate     Int?      // Unix timestamp
  createdAt      Int       // Unix timestamp
  items          POItem[]
}

model POItem {
  id             String       @id @default(uuid())
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  description    String
  qty            Float         // Float for Float
  unitPrice      Float         // Float for Float
}

model Bill {
  id           String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billNumber   String   @unique
  supplierId   String
  supplier     Connection @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  dueDate      Int?     // Unix timestamp
  amount       Float     // Float for Float
  paidAmount   Float     @default(0) // Float for Float
  status       String?
}

model SupportTicket {
  id           String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketNumber String      @unique
  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  issueType    String
  priority     String      // e.g., "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status       String      // e.g., "OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"
  createdAt    Int         // Unix timestamp
  comments     TicketComment[]
}

model TicketComment {
  id           String       @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content      String
  isInternal   Int           @default(0) // Boolean as Int
  createdAt    Int           // Unix timestamp
}

model SupplierFeedback {
  id           String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Connection @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  feedbackType String
  details      String?
  resolved     Int      @default(0) // Boolean as Int
}

model Activity {
  id           String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         String
  notes        String?
  relatedType  String?
  relatedId    String?
  createdAt    Int      // Unix timestamp
}

model Document {
  id           String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name         String
  path         String
  category     String?
  relatedType  String?
  relatedId    String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   Int      // Unix timestamp
}

model Notification {
  id        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  isRead    Int      @default(0) // Boolean as Int
  createdAt Int      // Unix timestamp
}

// Analytics & commission
model SalesTarget {
  id        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  period    String
  amount    Float     // Float for Float
  achieved  Float     @default(0) // Float for Float
}

model CommissionRule {
  id           String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productCategory String?
  minAmount    Float?  // Float for Float
  maxAmount    Float?  // Float for Float
  percentage   Float   // Float for Float
}

model Commission {
  id           String  @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId      String?
  amount       Float    // Float for Float
  paidStatus   String?
}

// Audit
model AuditLog {
  id        String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      String?  // JSON as String
  createdAt Int      // Unix timestamp
}

// Email Verification
model VerificationToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// Magic Link Login
model MagicLinkToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation("MagicLinkTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// Organization Invitations
model OrganizationInvite {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String   // "ADMIN" or "MEMBER"
  invitedById    String
  invitedBy      User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  token          String   @unique
  status         String   @default("PENDING") // "PENDING", "ACCEPTED", "CANCELLED", "EXPIRED"
  expiresAt      DateTime
  createdAt      Int      // Unix timestamp
  updatedAt      Int      // Unix timestamp
}